{
  "build": {
    "beforeDevCommand": "echo 'Starting dev server...'",
    "beforeBuildCommand": "echo 'Building...'",
    "distDir": "../src"
  },
  "package": {
    "productName": "FileExplorer",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "shell": {
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "identifier": "com.example.fileexplorer",
      "targets": [
        "nsis"
      ]
    },
    "windows": [
      {
        "title": "File Explorer",
        "width": 800,
        "height": 600,
        "resizable": true
      }
    ]
  }
}