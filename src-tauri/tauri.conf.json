{
  "build": {
    "beforeDevCommand": "npm run preview",
    "beforeBuildCommand": "echo Building...",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "BAT_R",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true,
        "execute": true,
        "scope": [
          {
            "name": "cmd",
            "cmd": "cmd",
            "args": [
              { "validator": "\\S*" }
            ]
          }
        ]
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "scope": ["**"]
      },
      "path": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "target",
      "identifier": "com.example.bat-r",
      "icon": ["icons/icon.ico"]
    },
    "windows": [
      {
        "title": "BAT_R",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}