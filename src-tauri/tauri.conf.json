{
  "build": {
    "beforeDevCommand": "npm run preview",
    "beforeBuildCommand": "echo Building...",
    "distDir": "../src"
  },
  "package": {
    "productName": "FileExplorer",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true,
        "execute": true
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "readDir": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.example.fileexplorer",
      "icon": ["icons/icon.ico"]
    },
    "windows": [
      {
        "title": "File Explorer",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}